# MiniClaude sync-server configuration
SYNC_SERVER_ADDR=:8080
SYNC_SERVER_APP_URL=http://localhost:8080
SYNC_SERVER_COOKIE_SECURE=false
SYNC_SERVER_JWT_SECRET=dev-jwt-secret-change-me-32-bytes-min
SYNC_SERVER_PROVIDER_SECRET_KEY=dev-provider-secret-key-change-me-32
SYNC_SERVER_SESSION_TTL=24h
SYNC_SERVER_SHUTDOWN_TIMEOUT=10s
SYNC_SERVER_MIGRATIONS_DIR=migrations

DATABASE_URL=postgres://miniclaude:miniclaude@localhost:5432/miniclaude_sync?sslmode=disable
