# ============================================================
# MiniClaude environment configuration (development mode)
# ============================================================
# Copy to .env before use: cp .env.example .env
# For regular use, ~/.claude/settings.json is recommended. See README and settings.example.json.
#
# Priority: settings.json > .env
# settings.json is authoritative; .env is only a temporary development/debug override.

# ============================================================
# Required
# ============================================================
ANTHROPIC_API_KEY=your-api-key-here

# ============================================================
# Model and API (optional)
# ============================================================
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_MODEL=deepseek-v4-pro[1m]
# ANTHROPIC_SMALL_FAST_MODEL=deepseek-v4-flash
# MINICLAUDE_SYNC_SERVER_URL=http://localhost:8080

# ============================================================
# Behavior toggles (optional)
# ============================================================
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# FAST_MODE=1                       # Fast mode
# ENABLE_PROMPT_CACHING_1H=true     # Enable 1-hour prompt caching
