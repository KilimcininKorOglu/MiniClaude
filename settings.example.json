{
  "// MiniClaude configuration example": "Copy this file to ~/.claude/settings.json and edit it",
  "// ~/.claude path": "Linux/macOS: ~/.claude/settings.json | Windows: C:\\Users\\<username>\\.claude\\settings.json",

  "// Environment variables and models": "",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
    "ANTHROPIC_AUTH_TOKEN": "sk-your-api-key-here",
    "ANTHROPIC_MODEL": "deepseek-v4-pro[1m]",
    "API_TIMEOUT_MS": "3000000",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ENABLE_PROMPT_CACHING_1H": "true"
  },
  "model": "deepseek-v4-pro[1m]",
  "defaultModels": {
    "sonnet": "deepseek-v4-flash",
    "haiku": "deepseek-v4-flash",
    "opus": "deepseek-v4-pro[1m]"
  },
  "effort": "high",

  "// Optional sync server": "Run /login http://localhost:8080 inside MiniClaude to link this settings file to a sync-server workspace. Sync credentials are stored separately under the MiniClaude config directory.",

  "// Multi-provider hot switching": "",
  "providers": {
    "deepseek": {
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "sk-your-deepseek-key",
        "ANTHROPIC_MODEL": "deepseek-v4-pro[1m]"
      },
      "model": "deepseek-v4-pro[1m]",
      "defaultModels": {
        "sonnet": "deepseek-v4-flash",
        "haiku": "deepseek-v4-flash",
        "opus": "deepseek-v4-pro[1m]"
      },
      "description": "DeepSeek V4 - low cost, text-only"
    },
    "kiro": {
      "env": {
        "ANTHROPIC_BASE_URL": "http://127.0.0.1:8765",
        "ANTHROPIC_AUTH_TOKEN": "sk-your-kiro-key",
        "ANTHROPIC_MODEL": "claude-sonnet-4-6"
      },
      "model": "claude-sonnet-4-6",
      "defaultModels": {
        "sonnet": "claude-sonnet-4-6",
        "haiku": "claude-sonnet-4-6",
        "opus": "claude-sonnet-4-6"
      },
      "description": "Claude Sonnet 4.6 - vision capable"
    }
  },

  "// Permissions": "",
  "permissions": {
    "defaultMode": "default",
    "_description": "'default' asks each time | 'acceptEdits' automatically accepts edits | 'bypassPermissions' skips confirmations entirely"
  },
  "skipDangerousModePermissionPrompt": false,

  "autoMode": {
    "hard_deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force main)"
    ]
  },

  "// MCP servers": "",
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  },

  "// Plugin marketplaces": "",
  "enabledPlugins": {
    "superpowers@agents-skills-plugins": true,
    "code-review@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "agents-skills-plugins": {
      "source": {
        "source": "github",
        "repo": "EricGrill/agents-skills-plugins"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },

  "// Interface": "",
  "language": "en",
  "theme": "dark",
  "fastMode": false,
  "alwaysThinkingEnabled": true,
  "showTurnDuration": true,
  "includeCoAuthoredBy": true,

  "// Additional configuration options": {
    "cleanupPeriodDays": "Session retention days; 0 disables persistence",
    "outputStyle": "Output style",
    "hooks": "Lifecycle hook scripts",
    "theme": "'dark' | 'light' | 'dark-daltonized'"
  }
}
